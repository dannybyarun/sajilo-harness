#!/usr/bin/env bash
# sajilo - launch Sajilo, a coding agent harness, in its own sandbox.
#
# Sajilo owns its own harness spec (the system prompt and the 12-tool set in
# plugin/resources) and runs it on an isolated opencode runtime: its own HOME,
# its own sessions, its own project directory, its own relay, its own tunnel.
#
# It is independent of any opencode you are already running:
#   * its own HOME        -> its own opencode.db, sessions, config, plugins
#   * its own project dir -> <root>/work
#   * its own relay       -> 127.0.0.1:43914 (by default; the live one is 43904)
#   * its own tunnel      -> optional: a usque/WARP proxy on 127.0.0.1:40003
#                           with its own identity. Where usque does not exist
#                           (Windows, macOS) the relay simply uses the device's
#                           native egress - still a separate instance.
#   * its own rotator / watchdog / rescue log / pins / mint dir
#
# Nothing it does can touch an opencode you are already talking to: different
# ports, different HOME, different state directory.
#
# Usage:
#   sajilo                # interactive TUI in the sajilo project
#   sajilo run "hello"    # headless, one prompt
#   sajilo status         # what is running
#   sajilo shell          # a shell with the sajilo environment exported
#   sajilo direct         # talk to the gateway directly (no relay)
set -u

ROOT=${SAJILO_ROOT:-$HOME/.sajilo}
HOME_DIR="$ROOT/home"
STATE="$ROOT/state"
WORK="$ROOT/work"
TUNNEL_DIR="$ROOT/tunnel"
RELAY_PORT=${SAJILO_RELAY_PORT:-43914}
TUNNEL_PORT=${SAJILO_TUNNEL_PORT:-40003}
PLUGIN_DIR="$HOME_DIR/.config/opencode/plugin"
# The opencode binary is sajilo's runtime. The installer pins the exact one it
# found (or downloaded) so sajilo always starts the same binary, whatever
# shell launched it. The pin is only used when it really is executable, so a
# Windows path written by the Windows installer can never break this launcher.
if [ -z "${SAJILO_BIN:-}" ] && [ -z "${OPENCODE_BIN:-}" ]; then
  for _pin in "$STATE/sajilo-bin.txt" "$STATE/opencode-bin.txt"; do
    [ -f "$_pin" ] || continue
    _pinned=$(head -n 1 "$_pin" 2>/dev/null || true)
    if [ -n "$_pinned" ] && [ -x "$_pinned" ]; then
      SAJILO_BIN="$_pinned"
      break
    fi
  done
fi
# A rebranded runtime ("sajilo rebrand") is this instance's own patched copy
# and wins over everything else - it is the only way to change the welcome art
# without touching the opencode the rest of the machine uses.
if [ -z "${OPENCODE_BIN:-}" ] && [ -f "$STATE/rebrand.txt" ]; then
  _rb=$(head -n 1 "$STATE/rebrand.txt" 2>/dev/null | tr -d '\r' || true)
  [ -n "$_rb" ] && [ -x "$_rb" ] && SAJILO_BIN="$_rb"
fi
OPENCODE_BIN=${SAJILO_BIN:-${OPENCODE_BIN:-opencode}}
RESOURCES_DIR="$ROOT/resources"

# The model pin: written by "sajilo model <name>", read by the launcher (for
# the runtime config) and by the relay (for every upstream request).
MODEL_FILE="$STATE/model.txt"
MODEL_ID=""
MODEL_AUTO=""
if [ -f "$MODEL_FILE" ]; then
  MODEL_ID=$(head -n 1 "$MODEL_FILE" 2>/dev/null | tr -d '\r' || true)
fi
if [ "$MODEL_ID" = "auto" ]; then
  MODEL_ID=""
  MODEL_AUTO=1
fi
# No pin and no "auto" -> the default model. The relay leads with the same
# one, so the harness and the relay always agree.
if [ -z "$MODEL_ID" ] && [ -z "$MODEL_AUTO" ]; then
  MODEL_ID="deepseek-v4.1-flash-free"
fi
PROVIDER_PREFIX=sajilo
PROVIDER_NAME=Sajilo
[ -f "$STATE/stock-identity" ] && PROVIDER_PREFIX=opencode && PROVIDER_NAME=OpenCode

# Where to run: the directory you are standing in, or the one you name -
# exactly like opencode does. The isolation comes from the HOME (own DB, own
# sessions, own config), never from the project directory.
TARGET="$PWD"
if [ -n "${1:-}" ] && [ -d "$1" ]; then
  TARGET=$(cd "$1" && pwd)
  shift
fi

mkdir -p "$HOME_DIR/.config/opencode" "$PLUGIN_DIR/resources" "$STATE" "$WORK" \
  "$TUNNEL_DIR" "$ROOT/mint" "$ROOT/bin" 2>/dev/null || true

# ---------------------------------------------------------------- environment
export HOME="$HOME_DIR"
export USERPROFILE="$HOME_DIR" 2>/dev/null || true   # Bun on Windows
export SAJILO_ROOT="$ROOT"
export SAJILO_RELAY_PORT="$RELAY_PORT"
export SAJILO_RELAY_DIR="$PLUGIN_DIR"
export SAJILO_RELAY_MINT_DIR="$ROOT/mint"
export SAJILO_RELAY_ACTIVITY_LOG="$STATE/relay-activity.log"
export SAJILO_RELAY_UPSTREAM_FILE="$STATE/relay-upstream.txt"
export SAJILO_RELAY_DIRECT_EGRESS_FLAG="$STATE/direct-egress"
export SAJILO_RELAY_RESCUE_LOG="$STATE/rescue.log"
export SAJILO_RELAY_MODEL_FILE="$MODEL_FILE"
export SAJILO_RELAY_DUMP_DIR="$STATE"
export SAJILO_RELAY_RUNTIME="$OPENCODE_BIN"

# The TUI's own identity. The runtime draws its product name in the window
# title and the splash banner; these CLI settings are injected inline
# (nothing to edit by hand):
#   terminal.title false -> the tab stops saying "OpenCode"
#   highlights false     -> no update dialog on start
#   mini.splash hide     -> no entry/exit splash banner
# The provider in the config above is what the TUI prints next to the model
# (Sajilo, not OpenCode). "sajilo rebrand --restore" drops the stock marker:
# this instance goes back to the stock opencode identity.
if [ -f "$STATE/stock-identity" ]; then
  unset OPENCODE_CLI_CONFIG_CONTENT
else
  export OPENCODE_CLI_CONFIG_CONTENT='{"terminal":{"title":false},"highlights":false,"mini":{"splash":"hide"}}'
fi
export SAJILO_RELAY_ROTATOR="$ROOT/bin/warp-rotate.sh"
export SAJILO_RELAY_WATCHDOG="$ROOT/bin/tunnel-watchdog.sh"export SAJILO_ROTATE_MARKER="$STATE/.rotate.inprogress"

tunnel_up() {
  curl -s -m 8 -x "http://127.0.0.1:$TUNNEL_PORT" \
    https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null | grep -q '^warp=on'
}

# usque is the instance's own rotatable tunnel: a user-space WARP client, so
# installing and rotating it needs no administrator rights. The installer
# puts it in the instance's bin; a system-wide one is used if it is there.
have_usque() { [ -x "$BIN_DIR/usque" ] || command -v usque >/dev/null 2>&1; }
usque_bin() { if [ -x "$BIN_DIR/usque" ]; then echo "$BIN_DIR/usque"; else command -v usque; fi; }

# Is the local Cloudflare WARP proxy listening? The WARP service
# (warp-svc.exe) exposes it on 127.0.0.1:40000 while WARP is on.
warp_proxy_up() {
  (exec 3<>/dev/tcp/127.0.0.1/40000) >/dev/null 2>&1
}

start_tunnel() {
  have_usque || return 1
  local usque; usque="$(usque_bin)"
  local conf="$TUNNEL_DIR/config.json"
  if [ ! -f "$conf" ]; then
    (cd "$TUNNEL_DIR" && env -u HTTPS_PROXY -u HTTP_PROXY -u https_proxy -u http_proxy \
      "$usque" register -a -c "$conf" -n "sajilo-$(date +%s)") >>"$STATE/register.log" 2>&1
  fi
  (cd "$TUNNEL_DIR" && env -u HTTPS_PROXY -u HTTP_PROXY -u https_proxy -u http_proxy \
    setsid nohup "$usque" -c "$conf" http-proxy -b 127.0.0.1 -p "$TUNNEL_PORT" \
    >>"$STATE/usque.log" 2>&1 & echo $! >"$STATE/usque.pid")
  for _ in $(seq 1 30); do
    sleep 1
    tunnel_up && return 0
  done
  return 1
}

use_tunnel() {
  tunnel_up || start_tunnel || return 1
  export WARP_PROXY_PORT="$TUNNEL_PORT"
  export HTTPS_PROXY="http://127.0.0.1:$TUNNEL_PORT"
  export HTTP_PROXY="http://127.0.0.1:$TUNNEL_PORT"
  export SAJILO_RELAY_PROXY="http://127.0.0.1:$TUNNEL_PORT"
  export NO_PROXY="127.0.0.1,localhost,::1"
  export no_proxy="127.0.0.1,localhost,::1"
  return 0
}

use_native() {
  # No tunnel (or none available): sajilo relay talks to the gateway through
  # the device's native egress. The proxied leg of the egress ladder is still
  # worth having when it exists: the free allowance is keyed on the exit IP, so
  # a second egress is a second bucket and a drained one can be climbed over.
  # The Cloudflare WARP service (warp-svc.exe) listens on 127.0.0.1:40000
  # while WARP is on - that is the local proxy to use. Whatever the user set is
  # kept.
  unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy ALL_PROXY all_proxy
  unset WARP_PROXY_PORT
  if [ -z "${SAJILO_RELAY_PROXY:-}" ] && warp_proxy_up; then
    export SAJILO_RELAY_PROXY="http://127.0.0.1:40000"
  fi
  export NO_PROXY="127.0.0.1,localhost,::1"
  export no_proxy="127.0.0.1,localhost,::1"
}

# Point sajilo's opencode at sajilo RELAY. Then the opencode client inherits
# everything the relay knows how to do: the gateway whitelist (the relay
# rewrites the body into the approved agent class), the limit reset (a 429
# gets a fresh identity, and the SAME model answers), the egress ladder
# (proxy -> native), and the keep-working rule (no multi-minute hangs, and no
# rate-limit error in the user's face). Without this the opencode client
# talks to the gateway directly and has NONE of that: one dead proxy and it
# fails with the gateway's own error.
use_relay() {
  mkdir -p "$HOME_DIR/.config/opencode" 2>/dev/null || true
  # The model the harness wants: one pin file, read live by BOTH sides.
  # "sajilo model <name>" writes it, this puts it in the runtime config, and
  # the relay honours the same file when a request carries no model - so
  # changing the model in the harness changes what the relay sends upstream.
  local model_json=""
  if [ -n "$MODEL_ID" ]; then
    model_json=",\"model\":\"$PROVIDER_PREFIX/$MODEL_ID\""
  fi
  # The provider and the model are NOT written into the config file - that
  # file belongs to the user (it is where "opencode mcp add", permissions,
  # agents and commands live). The relay plugin MERGES the sajilo provider
  # into it at startup, which keeps every other key intact.
  export SAJILO_RELAY_PROVIDER=sajilo
  [ -f "$STATE/stock-identity" ] && export SAJILO_RELAY_PROVIDER=opencode
}

use_direct() {
  # Opt out of the relay: the runtime talks to the gateway directly (no
  # ladder, no pool, no budget, no rescue). The config file is the user's and
  # is never touched, so nothing to remove here.
  export SAJILO_RELAY_PROVIDER=none
}

# sajilo model            -> show the current choice
# sajilo model <name>     -> pin the model (runtime AND relay follow it)
# sajilo model --auto     -> back to the free pool
model_cmd() {
  case "${1:-}" in
    "")
      if [ -n "$MODEL_ID" ]; then
        echo "model        : $MODEL_ID"
      else
        echo "model        : auto (the relay resets the limit, it never rotates models)"
      fi
      ;;
    --auto)
      rm -f "$MODEL_FILE" 2>/dev/null || true
      echo "model        : auto (the relay resets the limit, it never rotates models)"
      ;;
    *)
      mkdir -p "$STATE" 2>/dev/null || true
      printf '%s\n' "$1" >"$MODEL_FILE"
      echo "model pinned : $1"
      echo "              (the relay uses it on the next request; the free pool"
      echo "               still covers it if that model is drained)"
      ;;
  esac
}

status() {
  echo "root        : $ROOT"
  echo "relay       : $(curl -s -m 5 "http://127.0.0.1:$RELAY_PORT/relay-health" 2>/dev/null || echo DOWN)"
  echo "tunnel      : $(curl -s -m 8 -x "http://127.0.0.1:$TUNNEL_PORT" https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null | grep -E '^(ip|warp)=' | tr '\n' ' ' || echo 'none (native egress)')"
  echo "db          : $HOME_DIR/.local/share/opencode/opencode.db"
  echo "project     : $TARGET"
  echo "runtime     : $OPENCODE_BIN"
  if [ -n "$MODEL_ID" ]; then
    echo "model       : $MODEL_ID"
  else
    echo "model       : auto (the relay resets the limit, it never rotates models)"
  fi
  echo "usque       : $(have_usque && echo available || echo 'not installed - native egress only')"
  echo "live relay  : $(curl -s -m 5 http://127.0.0.1:43904/relay-health 2>/dev/null || echo 'not running')"
}

case "${1:-tui}" in
  status) status ;;
  rebrand)
    shift
    exec bash "$(dirname "$0")/sajilo-rebrand.sh" "$@"
    ;;
  mint)
    # A fresh session/project pair means a fresh quota bucket: every free
    # model's pool for THIS identity starts over, so a drained model becomes
    # usable again. Measured: deepseek had been 429ing for minutes, and after
    # one mint it served again.
    # ?force=1 skips the mint cooldown - asking for a mint means asking NOW.
    curl -s -m 180 -X POST "http://127.0.0.1:$RELAY_PORT/relay-mint?force=1" \
      -H "content-type: application/json" -d "{}"
    echo
    echo "A fresh pair means a fresh bucket: every free model's pool for THIS"
    echo "identity starts over, so a drained model becomes usable again."
    ;;
  doctor)
    # Is the harness and the relay healthy?
    if ! command -v bun >/dev/null 2>&1; then
      echo "sajilo doctor needs bun (https://bun.sh)" >&2
      exit 1
    fi
    exec bun run "$BIN_DIR/sajilo-doctor.ts"
    ;;
  relay)
    # The provider on its own, for other agents.
    # --lean: the caller's own prompt and tools only - no harness footprint.
    # The free allowance is weight-based, so a lean relay fits requests a
    # full one does not.
    for a in "$@"; do
      if [ "$a" = "--lean" ]; then
        export SAJILO_RELAY_TOOLS=caller
        export SAJILO_RELAY_HARNESS=caller
      fi
    done
    if ! command -v bun >/dev/null 2>&1; then
      echo "sajilo relay needs bun (https://bun.sh) - install it, or keep a sajilo" >&2
      echo "session open: the relay runs inside every sajilo instance." >&2
      exit 1
    fi
    exec bun run "$BIN_DIR/sajilo-relay.ts"
    ;;
  model)
    shift
    model_cmd "${1:-}"
    ;;
  shell)
    use_relay
    use_tunnel || use_native
    cd "$TARGET" && exec "${SHELL:-bash}"
    ;;
  serve)
    use_relay
    use_tunnel || use_native
    cd "$TARGET" && exec "$OPENCODE_BIN" serve --stdio
    ;;
  run)
    use_relay
    use_tunnel || use_native
    shift
    # --standalone: without it the CLI attaches to an ALREADY RUNNING
    # background service, so the session lands in THAT instance's DB and the
    # traffic rides THAT instance's proxy. This is what keeps sajilo separate.
    cd "$TARGET" && exec "$OPENCODE_BIN" run --standalone "$@"
    ;;
  tui|"")
    use_relay
    use_tunnel || use_native
    cd "$TARGET" && exec "$OPENCODE_BIN" --standalone
    ;;
  direct)
    # Opt out of the relay: the opencode client talks to the gateway directly
    # (no ladder, no pool, no budget, no rescue).
    use_direct
    use_tunnel || use_native
    shift
    cd "$TARGET" && exec "$OPENCODE_BIN" --standalone "$@"
    ;;
  *)
    use_relay
    use_tunnel || use_native
    cd "$TARGET" && exec "$OPENCODE_BIN" --standalone "$@"
    ;;
esac
